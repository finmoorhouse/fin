{
  "name": "fm-2",
  "version": "1.0.0",
  "description": "Fin's website",
  "scripts": {
    "serve": "eleventy --serve --quiet",
    "build": "rm -rf build && node scripts/image-dims.mjs && eleventy && node scripts/build-charts.mjs --minify && NODE_ENV=production postcss ./src/global.css > build/global-processed.css",
    "charts:build": "node scripts/build-charts.mjs --minify",
    "charts:watch": "node scripts/build-charts.mjs --watch",
    "tailwind:process": "npx postcss src/global.css --o build/global-processed.css --watch",
    "dev": "node scripts/image-dims.mjs && concurrently \"npm run tailwind:process\" \"npm run charts:watch\" \"npm run serve\"",
    "images:dims": "node scripts/image-dims.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@observablehq/plot": "^0.6.17",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vscode/markdown-it-katex": "^1.1.2",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.2",
    "cssnano": "^7.0.5",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.1.4",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.1",
    "temml": "^0.13.4"
  }
}
