---
# Metadata comes from _data/metadata.json
permalink: "{{ metadata.feed.path }}"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ metadata.feed.subtitle }}</subtitle>
  <link href="{{ metadata.feed.url }}" rel="self"/>
  <link href="{{ metadata.url }}"/>
  <updated>{{ collections.writing | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  {#- IDs stay on the old www. base (metadata.feed.id) even though links use the
      canonical apex domain: changing an entry's <id> makes feed readers treat
      it as a new post. -#}
  <id>{{ metadata.feed.id }}</id>
  <author>
    <name>{{ metadata.author.name }}</name>
  </author>
  {%- for post in collections.writing | reverse %}
  {% set absolutePostUrl %}{{ post.url | url | absoluteUrl(metadata.url) }}{% endset %}
  {% set postId %}{{ post.url | url | absoluteUrl(metadata.feed.id) }}{% endset %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <updated>{{ post.date |  dateToRfc3339 }}</updated>
    <id>{{ postId }}</id>
    <content type="html">{{ post.templateContent | excerpt | htmlToAbsoluteUrls(absolutePostUrl) }} (Read the full post at: {{ absolutePostUrl }}.)</content>
  </entry>
  {%- endfor %}
</feed>