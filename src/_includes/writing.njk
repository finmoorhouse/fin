---
layout: base.njk
# Opts this page into the wider, left-offset measure in writing.css. The
# listing at /writing loads that stylesheet too but isn't an essay, so it keeps
# the same centred column as /projects and the index.
mainClass: essay
extraStyle:
  ["/style/writing.css", "https://unpkg.com/katex@latest/dist/katex.min.css"]
---

<h1 class="!mb-2">{{ title }}</h1>
{% if page.date %}
<div class="font-sans text-base pb-6 mb-4">
  <p class="font-sans text-base">
    <span class="opacity-60">Published </span>{{
    page.date.toLocaleDateString("en-GB", {year: 'numeric', month: 'long', day:
    'numeric'}) }} {% if updated %}<span class="opacity-60"> ⋅ Updated </span>{{
    updated.toLocaleDateString("en-GB", {year: 'numeric', month: 'long', day:
    'numeric'}) }} {% endif %} {% if links %} ⋅ Comment on {% for platform, url
    in links %}
    <a
      href="{{ url }}"
      target="_blank"
      class="no-underline hover:underline decoration-dotted"
      >{{ platform }}</a
    >{{ ',' if not loop.last }} {% endfor %} {% endif %}
  </p>
  {% endif %} {% backLink "writing", "writing" %}
  <div class="border-b max-w-xs mt-6 border-rule"></div>
</div>

{% if content | toc %}

<details
  class="block desktop:hidden text-sm bg-panel rounded-md px-8 py-4 font-sans mb-4 ring-rule hover:ring-1"
>
  <summary class="text-md cursor-pointer font-medium">
    Contents
    <span class="hidde sm:inline opacity-60 serif"> (click to toggle)</span>
  </summary>
  {{ content | toc | safe}}
  <p class="!mb-2 !mt-0 pt-4 border-t border-rule inline-block">
    {{ content | wordStats }}
  </p>
</details>

<div
  class="side-nav opacity-60 text-sm hidden font-sans hover:opacity-100 transition-opacity"
>
  <div
    class="side-nav-offset hidden desktop:block overflow-auto hide-scrollbar pt-4"
  >
    <h3>Contents</h3>
    <p>{{ content | wordStats }}</p>
    {{ content | toc | safe}}
    <a
      href="#top"
      class="inline-block no-underline hover:underline decoration-dotted pt-3 mb-6 mt-2 border-t border-rule"
      >Back to top &#8593;</a
    >
  </div>
</div>
{% endif %} {{ content | safe}}

<br />

<aside class="bg-panel rounded-md px-5 py-2 border border-rule">
  You can
  <a href="https://www.admonymous.co/fin" target="_blank"
    >leave (anonymous) feedback</a
  >
  on this post, or any other aspect of this website.
</aside>
<br />
{% backLink "writing", "writing" %}

<script defer src="/script/notes.js"></script>
