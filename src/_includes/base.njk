{% from "theme-toggle.njk" import themeToggle %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="generator" content="Eleventy">
  <link href="https://github.com/finmoorhouse" rel="me">
  <link rel="webmention" href="https://webmention.io/www.finmoorhouse.com/webmention">
  <link rel="pingback" href="https://webmention.io/www.finmoorhouse.com/xmlrpc">
  <link rel="alternate" type="application/atom+xml" title="{{ metadata.title }}" href="{{ metadata.feed.url }}">
  <meta property="og:type" content="website">
  <meta name="author" content="Fin Moorhouse">
  <meta name="theme-color" content="#333948"><!-- kept in sync by the theme toggle -->
  <meta name="monetization" content="ilp.uphold.com/4rHyDzRz66Dw">
  <meta name="viewport" content="width=device-width, initial-scale=1"/>

  <!-- Analytics -->
  <script defer data-domain="finmoorhouse.com" src="https://plausible.io/js/script.js"></script>
  
  <!-- Twitter meta tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@finmoorhouse">
  <meta name="twitter:creator" content="@finmoorhouse">

  <!-- Description -->
  {% if description %}
  <meta name="twitter:description" content="{{ description }}">
  <meta name="description" content="{{ description }}">
  <meta property="og:description" content="{{ description }}">
  {% else %}
  <meta name="twitter:description" content="{{ site.description }}">
  <meta name="description" content="{{ site.description }}">
  <meta property="og:description" content="{{ site.description }}">
  {% endif %}  

  <!-- Title -->
  {% if title %}
  <meta name="twitter:title" content="{{ title }}">
  <meta property="og:title" content="{{ title }}">
  {% else %}
  <meta name="twitter:title" content="Fin Moorhouse">
  <meta property="og:title" content="Fin Moorhouse">
  {% endif %}
  
  <!-- Share image -->
  {% shareImage shareImage %}
  
  {% if canonicalUrl %}
  <!-- Canonical URL -->
  <link rel="canonical" href="{{canonicalUrl}}" />
  {% endif %}

  <!-- Theme: dark is the default, so this only has to act for readers who've
       opted into light. Blocking and before the stylesheet, so no flash. -->
  <script>try{if(localStorage.theme==='light'){document.documentElement.dataset.theme='light';document.querySelector('meta[name="theme-color"]').content='#faf8f4'}}catch(e){}</script>

  <!-- Additional styling. The body face is preloaded so it starts downloading
       alongside the stylesheet rather than after it's parsed. -->
  <link rel="preload" href="/fonts/spectral-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/global-processed.css"/>
  {% if extraStyle %}
  {% for styleLink in extraStyle %}
      <link rel="stylesheet" href="{{styleLink}}"/>
      {% endfor %}
  {% endif %}

  <title>{% if title %}{{ title }} - {% endif %}{{ site.author }}</title>

</head>
<body id="top" class="bg-page text-ink">
  <nav class="flex flex-row max-w-lg mx-auto justify-between py-4 text-sm px-4">
    <header class="flex flex-none opacity-50 hover:underline decoration-dotted"><a href="/">Fin Moorhouse</a></header>
    <ul class="flex flex-none gap-x-4">
    {% for item in nav.items %}
    <li class="inline"><a href="{{ item.url }}"
      {% if (item.url in page.url and item.url!="/") or (item.url == "/" and page.url == "/") %}
      aria-current="page" data-state="active" class="opacity-100 underline decoration-dotted"
      {% else %}
      class="opacity-50 hover:underline decoration-dotted"
      {% endif %} target="_self">{{ item.name }}</a>
    </li>
    {% endfor %}
    <li class="inline">
      {{ themeToggle() }}
    </li>
  </ul></nav>
  <main class="prose tablet:prose-lg font-serif pt-12 pb-12 {{ mainClass }}">
    {{ content | safe }}
    {#<small >{{ site.author }} &copy; {{ site.copyrightYear }}</small>#}
  </main>
  <script>
    // Essays carry a second copy of the switch in the contents sidebar, so this
    // binds every toggle on the page rather than one by id.
    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme !== "light" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]').content =
          next === "light" ? "#faf8f4" : "#333948";
        // Persisting is best-effort: localStorage throws when cookies are blocked.
        try { localStorage.theme = next; } catch (e) {}
        window.dispatchEvent(new Event("themechange"));
      });
    });
  </script>
</body>
</html>